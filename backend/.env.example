FLASK_ENV=development
SECRET_KEY=replace-with-a-secure-secret
JWT_SECRET_KEY=replace-with-a-secure-jwt-secret
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/
MONGO_DB_NAME=qadam_digital_website
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
PORT=5001
UPLOAD_FOLDER=uploads
MAX_UPLOAD_MB=10

# Public site origin (no trailing slash) for SEO canonical URLs, sitemap URLs, robots
FRONTEND_PUBLIC_URL=http://localhost:5173

# robots.txt — if false, disallow /admin/ and /api/admin/
ROBOTS_ALLOW_ALL=true

# Rate limiting on public POST endpoints (e.g. contact-requests)
RATE_LIMITING_ENABLED=true

# Set true only for debugging / tests
PROPAGATE_EXCEPTIONS=false

# Optional: absolute public URL of the API (no trailing slash), for upload URLs when frontend is on another origin
# SERVER_PUBLIC_BASE_URL=http://127.0.0.1:5001

# Optional: notify by email on new submissions (leave SMTP_HOST empty to disable)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# NOTIFY_EMAIL_TO=admin@example.com
